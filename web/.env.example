# Copy to .env.local and fill in what you have. Everything is optional:
# with nothing set, the app runs entirely in the browser and the AI features
# fall back to pattern matching.

# --- Claude -----------------------------------------------------------------
# Turns on résumé reading, listing matching, the story coach, interview
# questions, practice feedback, rewrites and reading a posting from its link.
# Server-side only: never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# --- Supabase ---------------------------------------------------------------
# Turns on real accounts (email magic link), Postgres storage and file storage
# for résumés and headshots. Run supabase/migrations/*.sql against the project
# first. Either the publishable key or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
